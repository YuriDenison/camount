<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

    <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">

        <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="AmountTextView (full):"
                android:textColor="#666666"
                android:textSize="14sp" />

        <io.denison.camount.view.AmountTextView
                android:id="@+id/amount_text_full"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textAppearance="@style/TextAppearance.Sample.AmountLarge"
                app:amount_formatter="full"
                app:amount_showSign="if_negative" />

        <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="AmountTextView (ignore zero nanos, always sign):"
                android:textColor="#666666"
                android:textSize="14sp" />

        <io.denison.camount.view.AmountTextView
                android:id="@+id/amount_text_short"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textAppearance="@style/TextAppearance.Sample.Amount"
                app:amount_formatter="ignoreZeroNanos"
                app:amount_showSign="always" />

        <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:text="AmountEditView (tap to edit):"
                android:textColor="#666666"
                android:textSize="14sp" />

        <io.denison.camount.view.AmountEditView
                android:id="@+id/amount_edit"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:cursorVisible="true"
                android:gravity="start|center_vertical"
                android:textAppearance="@style/TextAppearance.Sample.AmountLarge"
                app:amount_cursorColor="#4049FF"
                app:amount_enableInputConnection="true"
                app:amount_fixedFractionTextColor="#C4C4C4"
                app:amount_withFixedZeroNotation="false"
                app:amount_zeroNotationTextColor="#C4C4C4" />

        <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="AmountEditView (gradient, fixed zero notation):"
                android:textColor="#666666"
                android:textSize="14sp" />

        <io.denison.camount.view.AmountEditView
                android:id="@+id/amount_edit_gradient"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:cursorVisible="true"
                android:gravity="center"
                android:textAppearance="@style/TextAppearance.Sample.AmountLarge"
                app:amount_cursorColor="#FF4081"
                app:amount_enableInputConnection="true"
                app:amount_gradientEndColor="#FF4081"
                app:amount_gradientOrientation="horizontal"
                app:amount_gradientStartColor="#4049FF"
                app:amount_withFixedZeroNotation="true" />

    </LinearLayout>
</ScrollView>
